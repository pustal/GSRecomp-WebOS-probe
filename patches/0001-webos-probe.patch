diff --git a/engine/src/armv4t/runtime_arm.cpp b/engine/src/armv4t/runtime_arm.cpp
index fd4eb70..bafe776 100644
--- a/engine/src/armv4t/runtime_arm.cpp
+++ b/engine/src/armv4t/runtime_arm.cpp
@@ -2369,9 +2369,9 @@ void runtime_dispatch(uint32_t target_pc) {
         // Resolve first, then invoke with no work after the call. This is the
         // guest tail-transfer boundary; GCC/Clang can lower it to a jump.
         if (RuntimeGuestFn fn = g_runtime_ram_dispatch_hook(pc, thumb ? 1 : 0)) {
-#if defined(__clang__)
-            [[clang::musttail]]
-#endif
+            // (webOS probe) No [[clang::musttail]]: clang requires the callee's
+            // signature to match this function's, and it does not (no
+            // parameters vs. two). A plain return is still a tail call at -O2.
             return fn();
         }
     }
